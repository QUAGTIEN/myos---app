{
  "name": "myos-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests/e2e next.config.ts playwright.config.ts eslint.config.mjs postcss.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/e2e/*.ts\" playwright.config.ts next.config.ts eslint.config.mjs postcss.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/e2e/*.ts\" playwright.config.ts next.config.ts eslint.config.mjs postcss.config.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@radix-ui/react-dialog": "1.2.0",
    "lucide-react": "1.52.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "prettier": "3.9.9",
    "@eslint/eslintrc": "3.3.3"
  }
}
